<?xml version="1.0" encoding="UTF-8"?>
<!--
    Unit tests for the framework-free core: the provider presets, the settings they resolve to,
    the SMTP conversation the health check holds, the reading it gives a shopkeeper and the
    decision to warn. They need neither Magento nor a mail server:

        vendor/bin/phpunit -c phpunit.xml.dist
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="calmfox-smtp">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">Core</directory>
        </include>
    </source>
</phpunit>
